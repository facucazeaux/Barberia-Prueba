# =============================================================
# VARIABLES DE ENTORNO - Barbería Turnos
# =============================================================
# Copia este archivo a .env.local y configura los valores reales
# para producción. Los valores actuales son para desarrollo.

# -------------------------------------------------------------
# SERVICIO DE EMAIL (RESEND)
# -------------------------------------------------------------
# API Key de Resend para enviar emails de confirmación
# Obtén tu API key en: https://resend.com/api-keys
VITE_RESEND_API_KEY=re_your_api_key_here

# Email desde el cual se enviarán las confirmaciones
# Debe estar verificado en tu cuenta de Resend
VITE_RESEND_FROM_EMAIL=noreply@tudominio.com

# -------------------------------------------------------------
# GOOGLE CALENDAR API
# -------------------------------------------------------------
# ID del calendario central de la barbería (para el admin)
# Todos los turnos se sincronizan aquí
VITE_GOOGLE_ADMIN_CALENDAR_ID=primary

# IDs de los calendarios personales de cada barbero
# Configura un calendario de Google para cada barbero y usa su ID
VITE_GOOGLE_JUAN_CALENDAR_ID=juan.calendar@example.com
VITE_GOOGLE_MARTIN_CALENDAR_ID=martin.calendar@example.com
VITE_GOOGLE_SOFIA_CALENDAR_ID=sofia.calendar@example.com

# API Key de Google Calendar (opcional para algunos métodos)
# Para producción con API REST de Google Calendar
# Obtén tu API key en: https://console.cloud.google.com/
VITE_GOOGLE_API_KEY=your_google_api_key_here

# -------------------------------------------------------------
# SUPABASE (FUTURO)
# -------------------------------------------------------------
# Cuando migres a Supabase, configura estas variables:
# VITE_SUPABASE_URL=your_supabase_project_url
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# -------------------------------------------------------------
# CONFIGURACIÓN DE LA BARBERÍA
# -------------------------------------------------------------
# Nombre del negocio (se usa en emails y calendarios)
VITE_BUSINESS_NAME=Barbería El Zaguán

# Dirección del negocio
VITE_BUSINESS_ADDRESS=Av. Corrientes 1234, CABA

# Zona horaria (formato IANA)
VITE_TIMEZONE=America/Argentina/Buenos_Aires

# -------------------------------------------------------------
# CREDENCIALES DE ADMIN (DESARROLLO)
# -------------------------------------------------------------
# Email y contraseña para acceder al panel admin
# En producción, esto será reemplazado por Supabase Auth
VITE_ADMIN_EMAIL=admin@barberia.com
VITE_ADMIN_PASSWORD=admin123